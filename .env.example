# Adobe Lightroom Cloud catalog API (navigation/import).
LIGHTROOM_MODE=mock
LIGHTROOM_API_BASE=https://lr.adobe.io/v2
LIGHTROOM_API_KEY=
# The Adobe catalog endpoint currently returns 401 without this user access token.
LIGHTROOM_ACCESS_TOKEN=
LIGHTROOM_OAUTH_CLIENT_ID=
LIGHTROOM_OAUTH_SCOPES=lr_partner_rendition_apis,openid,offline_access,AdobeID,lr_partner_apis
LIGHTROOM_OAUTH_REDIRECT_URI=
LIGHTROOM_CATALOG_ID=

# Adobe Firefly Lightroom API (image processing; deprecated in the supplied spec).
ADOBE_CLIENT_ID=cd0087d6c56a4d8199b537d4c7d82490
ADOBE_ACCESS_TOKEN=
FIREFLY_LIGHTROOM_API_BASE=https://image.adobe.io